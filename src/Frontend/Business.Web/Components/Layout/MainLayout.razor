@inherits LayoutComponentBase
@inject AppStateService AppState
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider IsDarkMode="AppState.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!AppState.IsAuthenticated)
{
    @Body
}
else
{
    <MudLayout>
        <MudAppBar Elevation="1" Color="Color.Primary" Fixed="true">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                Color="Color.Inherit"
                Edge="Edge.Start"
                OnClick="ToggleDrawer" />
            <MudText Typo="Typo.h6" Class="ml-3">Business ERP</MudText>
            <MudSpacer />
            <MudText Typo="Typo.body2" Class="mr-3">@AppState.CurrentUser?.FullName</MudText>
            <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Class="mr-2">
                @AppState.CurrentUser?.RoleName
            </MudChip>
            <MudIconButton Icon="@(AppState.IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                Color="Color.Inherit"
                OnClick="ToggleTheme"
                title="@(AppState.IsDarkMode ? "Modo claro" : "Modo oscuro")" />
            <MudIconButton Icon="@Icons.Material.Filled.Logout"
                Color="Color.Inherit"
                OnClick="Logout"
                title="Cerrar sesión" />
        </MudAppBar>
        <MudDrawer @bind-Open="_drawerOpen"
            ClipMode="DrawerClipMode.Always"
            Elevation="2"
            Variant="DrawerVariant.Responsive">
            <MudDrawerHeader>
                <MudText Typo="Typo.subtitle1" Class="mt-2 ml-1">
                    <b>Menú Principal</b>
                </MudText>
            </MudDrawerHeader>
            <NavMenu Menus="AppState.CurrentUser?.Menus ?? new()" />
        </MudDrawer>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4 mb-4">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _drawerOpen = true;
    private Action? _onChangeHandler;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _onChangeHandler = async () => await InvokeAsync(StateHasChanged);
            AppState.OnChange += _onChangeHandler;

            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "darkMode");
            if (bool.TryParse(stored, out var isDark))
                AppState.SetDarkMode(isDark);

            if (!AppState.IsAuthenticated)
                Navigation.NavigateTo("/login", forceLoad: false);
        }
    }

    private async Task ToggleTheme()
    {
        AppState.ToggleDarkMode();
        await JS.InvokeVoidAsync("localStorage.setItem", "darkMode", AppState.IsDarkMode);
    }

    public void Dispose()
    {
        if (_onChangeHandler != null)
            AppState.OnChange -= _onChangeHandler;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void Logout()
    {
        AppState.ClearUser();
        Navigation.NavigateTo("/login", forceLoad: false);
    }
}
