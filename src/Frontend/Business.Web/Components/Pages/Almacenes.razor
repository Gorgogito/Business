@page "/almacenes"
@inject ApiService ApiService
@inject AppStateService AppState
@inject ISnackbar Snackbar

<PageTitle>Almacenes - Business ERP</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Gestión de Almacenes</MudText>

<MudCard>
    <MudCardHeader>
        <CardHeaderActions>
            @if (AppState.HasPermission("inventory.manage"))
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                OnClick="OpenCreateDialog">Nuevo Almacén</MudButton>
            }
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudDataGrid T="AlmacenModel" Items="_almacenes" Loading="_loading"
            Filterable="true" Hover="true" Striped="true" Dense="true">
            <Columns>
                <PropertyColumn Property="x => x.Codigo" Title="Código" />
                <PropertyColumn Property="x => x.Nombre" Title="Nombre" />
                <PropertyColumn Property="x => x.Ubicacion" Title="Ubicación" />
                <TemplateColumn Title="Estado">
                    <CellTemplate>
                        <MudChip T="string" Size="Size.Small"
                            Color="@(context.Item.IsActive ? Color.Success : Color.Error)">
                            @(context.Item.IsActive ? "Activo" : "Inactivo")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Acciones">
                    <CellTemplate>
                        @if (AppState.HasPermission("inventory.manage"))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                            OnClick="@(() => OpenEditDialog(context.Item))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                            OnClick="@(() => DeleteAlmacen(context.Item.Id))" />
                    }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
    </MudCardContent>
</MudCard>

@if (_showDialog)
{
    <MudDialog Visible="_showDialog" VisibleChanged="@(v => _showDialog = v)">
        <TitleContent>
            <MudText Typo="Typo.h6">@(_editing.Id == 0 ? "Nuevo Almacén" : "Editar Almacén")</MudText>
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_editing.Codigo" Label="Código" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_editing.Nombre" Label="Nombre" Variant="Variant.Outlined" Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_editing.Ubicacion" Label="Ubicación" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _showDialog = false)">Cancelar</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAlmacen">Guardar</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private List<AlmacenModel> _almacenes = new();
    private bool _loading = true;
    private bool _showDialog;
    private AlmacenModel _editing = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _loading = true;
        var result = await ApiService.GetAsync<List<AlmacenModel>>("api/almacenes");
        if (result?.Success == true) _almacenes = result.Data ?? new();
        _loading = false;
    }

    private void OpenCreateDialog() { _editing = new AlmacenModel(); _showDialog = true; }

    private void OpenEditDialog(AlmacenModel a)
    {
        _editing = new AlmacenModel { Id = a.Id, Codigo = a.Codigo, Nombre = a.Nombre, Ubicacion = a.Ubicacion };
        _showDialog = true;
    }

    private async Task SaveAlmacen()
    {
        var data = new { _editing.Codigo, _editing.Nombre, _editing.Ubicacion };
        ApiResponse<AlmacenModel>? result;
        if (_editing.Id == 0)
            result = await ApiService.PostAsync<AlmacenModel>("api/almacenes", data);
        else
            result = await ApiService.PutAsync<AlmacenModel>($"api/almacenes/{_editing.Id}", data);

        if (result?.Success == true)
        {
            Snackbar.Add(result.Message, Severity.Success);
            _showDialog = false;
            await LoadData();
        }
        else Snackbar.Add(result?.Message ?? "Error", Severity.Error);
    }

    private async Task DeleteAlmacen(int id)
    {
        var result = await ApiService.DeleteAsync<bool>($"api/almacenes/{id}");
        if (result?.Success == true) { Snackbar.Add("Almacén eliminado", Severity.Success); await LoadData(); }
        else Snackbar.Add(result?.Message ?? "Error", Severity.Error);
    }
}
